# Salin file ini menjadi .env.local lalu sesuaikan dengan MySQL kamu (default XAMPP: root tanpa password)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=spp_tk

# Alamat aplikasi, dipakai untuk tautan portal wali murid di pesan WhatsApp
APP_URL=http://localhost:3000

# Zona waktu sekolah: +07:00 WIB, +08:00 WITA, +09:00 WIT
DB_TIMEZONE=+07:00
